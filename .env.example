# ==============================================================================
# Biz Pulse AI - PayPal Sandbox & Backend Configuration
# ==============================================================================

# Server configuration
PORT=5000
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# PayPal Sandbox Credentials (SERVER-SIDE SECRETS - NEVER PREFIX WITH VITE_)
# Obtain from PayPal Developer Dashboard: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here

# PayPal Sandbox Webhook ID (Optional for dev, required for webhook verification in staging/prod)
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# Frontend PayPal Public Client ID (Client ID only - safe for browser SDK)
VITE_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here

